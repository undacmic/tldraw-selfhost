{
  "name": "tldraw-selfhost",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "concurrently -k -n server,web \"npm:dev:server\" \"npm:dev:web\"",
    "dev:server": "tsx watch src/server/index.ts",
    "dev:web": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build && tsc -p tsconfig.server.json",
    "start": "node dist/server/index.js",
    "mcp": "node dist/server/mcp.js",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test tests/*.test.ts",
    "test:e2e": "npm run build && playwright test"
  },
  "dependencies": {
    "@fastify/static": "10.1.8",
    "@fastify/websocket": "^11.0.0",
    "@fontsource-variable/inter": "5.3.0",
    "@modelcontextprotocol/sdk": "1.32.2",
    "@tldraw/assets": "5.6.0",
    "@tldraw/sync": "5.6.0",
    "@tldraw/sync-core": "5.6.0",
    "@tldraw/tlschema": "5.6.0",
    "@tldraw/utils": "5.6.0",
    "better-sqlite3": "^12.10.0",
    "fastify": "5.12.7",
    "react": "^19.2.1",
    "react-dom": "^19.2.1",
    "tldraw": "5.6.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@types/better-sqlite3": "^7.6.12",
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "concurrently": "^9.1.2",
    "tsx": "^4.19.2",
    "typescript": "^5.8.3",
    "vite": "8.3.5"
  }
}
